// Prisma schema for the French/Monaco double-entry accounting suite.
//
// Every domain model carries companyId and is scoped per-company — see
// CLAUDE.md "Multi-tenant data model". All monetary fields are
// Decimal @db.Decimal(15, 2) — see CLAUDE.md "Money handling". Never widen
// a monetary field to Float/Real/Double.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR = France (Article A47 A-1 du LPF rules apply).
/// MC = Monaco (rules verified independently — see CLAUDE.md "Monaco compliance").
enum Jurisdiction {
  FR
  MC
}

/// Which liasse fiscale is this company's official/fileable one —
/// REEL_NORMAL (2050-series) or REEL_SIMPLIFIE (2033-series). Both remain
/// available as display views regardless of this value; it only selects
/// which one is authoritative. Same role as Jurisdiction for VAT: a real
/// schema field the liasse module branches on explicitly, not inferred —
/// see specs/liasse-2050-implementation-spec.md.
enum Regime {
  REEL_NORMAL
  REEL_SIMPLIFIE
}

enum JournalType {
  ACHATS
  VENTES
  BANQUE
  CAISSE
  OPERATIONS_DIVERSES
  A_NOUVEAU
}

enum DepreciationMethod {
  LINEAR
  // Declining-balance (dégressif) coefficients are not yet implemented —
  // see CLAUDE.md and depreciation.service.ts. Do not select this value
  // from application code until the calculation is implemented.
  DECLINING
}

enum ImportStatus {
  PENDING
  COMMITTED
  FAILED
}

/// USER = what the person typed. ASSISTANT = the local model's reply,
/// optionally carrying toolCalls it wants executed before it can finish
/// answering. TOOL = a tool call's result, fed back to the model as the
/// next turn. See CLAUDE.md "AI chatbot" — this is the exact shape
/// replayed to the local model on every turn, not a separate transcript
/// format.
enum ChatMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// Which cloud LLM provider a CloudModelCredential authenticates to — see
/// CLAUDE.md "AI chatbot cloud tier" and
/// specs/ai-chatbot-cloud-tier-implementation-spec.md. Deliberately only
/// the two providers with verified, cited residency/DPA terms; an
/// OpenAI-compatible custom-endpoint option is explicitly deferred (a
/// user-supplied endpoint can't carry a stated residency guarantee) — do
/// not add a value here for it without updating that spec first.
enum CloudModelProvider {
  CLAUDE
  DEEPSEEK
}

/// Which port actually produced an ASSISTANT/TOOL message — see CLAUDE.md
/// "AI chatbot cloud tier". LOCAL is the only value any code path sets
/// today (no cloud engine is wired into ChatOrchestratorService yet); the
/// field exists now so the always-visible per-message indicator has real,
/// persisted state to render the moment a cloud turn becomes possible,
/// rather than being retrofitted later. Never inferred from
/// `cloudProvider` being non-null — always set explicitly, together, by
/// whichever code path persists the message.
enum ChatEngine {
  LOCAL
  CLOUD
}

/// A tenant ("dossier"). The UI only ever shows one Company today, but the
/// schema is multi-tenant from day one — every other model scopes to a
/// companyId. See CLAUDE.md "Multi-tenant data model".
model Company {
  id           String       @id @default(cuid())
  name         String
  jurisdiction Jurisdiction

  /// Selects which liasse fiscale (2050-series vs. 2033-series) is this
  /// company's official/fileable one — see the Regime enum doc comment.
  /// Defaults to REEL_NORMAL (the regime this app's first liasse pass
  /// implements) so existing companies aren't left null.
  regime Regime @default(REEL_NORMAL)

  /// French SIREN (9 digits). Required to produce a FEC export for a FR company.
  siren String?

  /// Monaco RCI (Registre du Commerce et de l'Industrie) identifier.
  rci String?

  vatNumber String?

  /// Structured, not free-text: the liasse fiscale / CERFA forms on the
  /// roadmap expect discrete address components, so this avoids parsing a
  /// blob later once real data exists.
  addressLine String?
  postalCode  String?
  city        String?
  country     String  @default("France")

  /// Next value to assign as Ecriture.ecritureNum (single global sequence —
  /// see CLAUDE.md "Ledger integrity" and EntriesService.validate). Never
  /// derive "next number" from MAX(ecritureNum) once ecritureNum is a
  /// String: lexical ordering breaks past 9 entries ("10" < "2"). This
  /// counter is incremented atomically inside the validation transaction.
  nextEcritureNum Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fiscalYears           FiscalYear[]
  accounts              Account[]
  journals              Journal[]
  ecritures             Ecriture[]
  ecritureLignes        EcritureLigne[]
  fixedAssets           FixedAsset[]
  depreciationEntries   DepreciationEntry[]
  vatRates              VatRate[]
  importBatches         ImportBatch[]
  chatSessions          ChatSession[]
  chatMessages          ChatMessage[]
  cloudModelCredentials CloudModelCredential[]
  ecritureDocuments     EcritureDocument[]
  ecritureDocumentLogs  EcritureDocumentAuditLog[]
  bankAccounts          BankAccount[]
  bankStatementImports  BankStatementImport[]
  bankStatementLines    BankStatementLine[]
  lettrageAuditLogs     LettrageAuditLog[]
}

/// Exercice comptable. Ecritures are validated (locked) relative to a
/// fiscal year's close, and FEC exports are always for exactly one
/// fiscal year.
model FiscalYear {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label     String
  startDate DateTime
  endDate   DateTime
  closedAt  DateTime?

  ecritures           Ecriture[]
  depreciationEntries DepreciationEntry[]

  @@unique([companyId, label])
  @@index([companyId])
}

/// Compte (PCG chart-of-accounts entry). Number-to-class validation
/// (leading digit -> PCG class 1-8) is enforced in the accounts service,
/// not the schema, so it can produce a clear domain error.
model Account {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// CompteNum in FEC terms.
  number String
  /// CompteLib in FEC terms.
  label  String

  /// Leading digit of `number`, i.e. the PCG class (1-8).
  pcgClass Int

  /// True for a compte auxiliaire (e.g. a specific client/supplier
  /// sub-account referenced from an EcritureLigne as CompAuxNum/CompAuxLib).
  isAuxiliary Boolean @default(false)

  parentId String?
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  linesAsMain EcritureLigne[] @relation("EcritureLigneCompte")
  linesAsAux  EcritureLigne[] @relation("EcritureLigneCompteAux")

  fixedAssetsAsAsset        FixedAsset[] @relation("FixedAssetAccount")
  fixedAssetsAsDepreciation FixedAsset[] @relation("FixedAssetDepreciationAccount")
  fixedAssetsAsExpense      FixedAsset[] @relation("FixedAssetExpenseAccount")

  bankAccount BankAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
}

/// Journal comptable (JournalCode / JournalLib in FEC terms).
model Journal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code  String
  label String
  type  JournalType

  ecritures Ecriture[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Écriture comptable (journal entry). See CLAUDE.md "Ledger integrity"
/// for the invariants that must hold before/at validation:
/// balance, sequential numbering, immutability once validated.
model Ecriture {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  journalId    String
  journal      Journal    @relation(fields: [journalId], references: [id])

  /// EcritureNum: assigned only at validation time, sequential and gapless
  /// per company. Null while the entry is a draft. String rather than Int
  /// so a future per-journal numbering scheme can use alphanumeric values
  /// (Art. A47 A-1 du LPF §100 shows both a global numeric sequence and a
  /// per-journal alphanumeric one — e.g. "AN0001" — as equally valid).
  /// The "next number" is tracked via Company.nextEcritureNum, not derived
  /// from this column, so lexical string ordering is never load-bearing.
  ecritureNum String?

  /// EcritureDate.
  ecritureDate DateTime

  /// PieceRef / PieceDate: reference to the supporting document.
  pieceRef  String?
  pieceDate DateTime?

  /// EcritureLib.
  libelle String

  /// ValidDate. Null = draft (editable). Set = immutable; corrections must
  /// be posted as a new reversing entry referencing this one.
  validatedAt DateTime?

  /// Set when this entry reverses/corrects another validated entry
  /// (contre-passation / extourne).
  reversesId String?
  reverses   Ecriture?  @relation("EcritureReversal", fields: [reversesId], references: [id])
  reversedBy Ecriture[] @relation("EcritureReversal")

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  lignes    EcritureLigne[]
  documents EcritureDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // EcritureNum is only meaningful once assigned, but must be unique per
  // company when present.
  @@unique([companyId, ecritureNum])
  @@index([companyId, fiscalYearId])
  @@index([companyId, journalId])
}

/// Ligne d'écriture. Exactly one of debit/credit is non-zero — enforced in
/// the entries service (see CLAUDE.md rule 4), not expressible in SQL alone.
model EcritureLigne {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  ecritureId String
  ecriture   Ecriture @relation(fields: [ecritureId], references: [id])

  compteId String
  compte   Account @relation("EcritureLigneCompte", fields: [compteId], references: [id])

  /// Compte auxiliaire (CompAuxNum/CompAuxLib), e.g. a specific client/supplier.
  compteAuxId String?
  compteAux   Account? @relation("EcritureLigneCompteAux", fields: [compteAuxId], references: [id])

  debit  Decimal @default(0) @db.Decimal(15, 2)
  credit Decimal @default(0) @db.Decimal(15, 2)

  /// EcritureLet / DateLet: lettrage (reconciliation) marker.
  lettrage     String?
  dateLettrage DateTime?

  /// Montantdevise / Idevise: original amount and currency for foreign-currency lines.
  montantDevise Decimal? @db.Decimal(15, 2)
  idDevise      String?

  /// The rate this line is taxed/taxable at, for VAT declaration purposes
  /// (see src/modules/vat/ca3-declaration.ts). Tags both the TVA line
  /// itself (a 4457x collectée account) and the corresponding revenue
  /// line at the same rate — one line-level tag drives both the
  /// collectée-by-rate and the base-HT-by-rate aggregation, rather than
  /// proliferating rate sub-accounts. Null on lines with no VAT relevance
  /// (bank, tiers, ...) and on historical lines predating this field —
  /// computeDeclaration() refuses to compute a period containing an
  /// untagged line on a VAT account rather than silently omitting it.
  vatRateId String?
  vatRate   VatRate? @relation(fields: [vatRateId], references: [id])

  /// Due date for a créance/dette line — feeds the 2057 (état des
  /// échéances) maturity split (see tableau-2057.ts). Optional: most
  /// lines (charges, produits, immobilisations, trésorerie) have no
  /// notion of a due date at all. A créance/dette line with no value
  /// here falls into 2057's documented default bucket rather than
  /// being guessed.
  dateEcheance DateTime?

  createdAt DateTime @default(now())

  /// The bank-statement line this ligne was reconciled against, if any —
  /// see CLAUDE.md "Bank reconciliation". Optional: most lignes are never
  /// bank-matched (only ones on a 512/514-family account typically are).
  bankStatementMatch BankStatementLine?

  @@index([companyId, ecritureId])
  @@index([companyId, compteId])
}

/// Immobilisation (fixed asset) for the depreciation module. Only
/// straight-line (LINEAR) amortization is implemented so far.
model FixedAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label                 String
  accountId             String
  account               Account @relation("FixedAssetAccount", fields: [accountId], references: [id])
  depreciationAccountId String
  depreciationAccount   Account @relation("FixedAssetDepreciationAccount", fields: [depreciationAccountId], references: [id])
  expenseAccountId      String
  expenseAccount        Account @relation("FixedAssetExpenseAccount", fields: [expenseAccountId], references: [id])

  acquisitionDate  DateTime
  serviceStartDate DateTime
  acquisitionValue Decimal            @db.Decimal(15, 2)
  residualValue    Decimal            @default(0) @db.Decimal(15, 2)
  usefulLifeYears  Int
  method           DepreciationMethod @default(LINEAR)

  /// Cession (disposal). Present from the start so the model doesn't need
  /// retrofitting once disposal is built, but no cession logic (plus/moins-
  /// value computation, posting the disposal écriture) exists yet — both
  /// fields stay null until that feature lands. Not exposed on any DTO yet.
  cessionDate  DateTime?
  cessionPrice Decimal?  @db.Decimal(15, 2)

  depreciationEntries DepreciationEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// One year's depreciation schedule line (dotation aux amortissements) for
/// a FixedAsset, optionally linked to the Ecriture that posted it.
model DepreciationEntry {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  fixedAssetId String
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id])
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])

  amount Decimal @db.Decimal(15, 2)

  postedEcritureId String?

  createdAt DateTime @default(now())

  @@unique([fixedAssetId, fiscalYearId])
  @@index([companyId])
}

/// Taux de TVA applicable for a company/jurisdiction over a date range.
/// Populated per-company because Monaco rates must be verified
/// independently rather than assumed identical to France — see CLAUDE.md.
model VatRate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label       String
  ratePercent Decimal   @db.Decimal(5, 2)
  validFrom   DateTime
  validTo     DateTime?

  ecritureLignes EcritureLigne[]

  @@index([companyId])
}

/// A committed Excel journal import. Ecritures created from an import are
/// drafts (unvalidated) until reviewed and validated like any other entry.
model ImportBatch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  fileName String
  status   ImportStatus @default(PENDING)
  errors   Json?

  ecritures Ecriture[]

  createdAt DateTime @default(now())
}

/// A local-only chat conversation with the AI assistant — see CLAUDE.md
/// "AI chatbot". Company-scoped like every domain table; nothing in this
/// table or its ChatMessage children is ever sent anywhere but the local
/// model this company's AiChatModule talks to (see LocalModelPort), UNLESS
/// a cloud proposal thread is explicitly open (see the two fields below and
/// CLAUDE.md "AI chatbot cloud tier" — "server-side thread/granularity
/// enforcement").
model ChatSession {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// First ~60 chars of the opening user message — a label for the session
  /// list. Never re-derived by an extra model call just to name a session.
  title String?

  /// Non-null while a bounded cloud-proposal thread is open on this
  /// session — the server-side half of "granularity: per-invocation,
  /// bounded to one proposal thread" (see cloud-thread-gate.ts and
  /// CLAUDE.md "AI chatbot cloud tier"). Opened only by a turn that
  /// supplies `cloudProvider` AND attaches a file to propose from; cleared
  /// the instant the thread reverts to local — an explicit "Revenir au
  /// local" action, or the next LOCAL-engine message sent in this session
  /// (AiChatService.sendMessage()'s local branch always clears it, whether
  /// or not one was open). A random id, not a foreign key to anything —
  /// it exists purely to gate "is cloud still legitimately open here",
  /// never referenced elsewhere.
  cloudProposalThreadId String?

  /// Which provider `cloudProposalThreadId` is bound to. Null whenever
  /// cloudProposalThreadId is null; the two are always set/cleared
  /// together, never independently. A thread may only continue for the
  /// SAME provider it was opened with — see decideCloudThread()'s own doc
  /// comment for why switching provider mid-thread is refused rather than
  /// silently reassigned.
  cloudProposalProvider CloudModelProvider?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([companyId])
}

/// One turn in a ChatSession's message list. This is deliberately the
/// exact shape replayed to the local model on every turn (see
/// chat-orchestrator.service.ts), not a separate transcript format.
model ChatMessage {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])

  role    ChatMessageRole
  content String          @db.Text

  /// Present only on an ASSISTANT message that requested one or more tool
  /// calls before it could finish answering — [{ id, name, arguments }].
  toolCalls Json?

  /// Present only on a TOOL message: which tool produced this result, and
  /// which tool-call id it answers — lets the trace render ("query_ca3 →
  /// {...}") without re-parsing toolCalls off the preceding assistant row.
  toolName   String?
  toolCallId String?

  /// Which port produced this message — see the ChatEngine enum's own doc
  /// comment. Defaults to LOCAL because every existing row, and every
  /// write path today, is local; CLOUD is not yet reachable.
  engine ChatEngine @default(LOCAL)

  /// Set only when engine is CLOUD — which provider. Null on every LOCAL
  /// row. `engine` itself is set on every row including USER (defaults to
  /// LOCAL, since it's a required column) even though a user's own typed
  /// message wasn't "produced by" any port — the frontend's per-message
  /// badge simply never renders one for the USER role, regardless of the
  /// stored value.
  cloudProvider CloudModelProvider?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([companyId])
}

/// A company's own (BYO) API key for one cloud LLM provider — used ONLY
/// by the propose_ecriture write path (see CLAUDE.md "AI chatbot cloud
/// tier"). Cloud is opt-in, never default: a row here only exists once a
/// user has explicitly completed the consent flow for that provider.
///
/// `encryptedApiKey` is ciphertext (AES-256-GCM, see
/// src/common/crypto/credential-encryption.service.ts), never plaintext.
/// The decryption key lives OUTSIDE this database entirely
/// (CLOUD_CREDENTIAL_ENCRYPTION_KEY) — that file's own doc comment states
/// the real threat model this defends against (a leaked DB backup or
/// DB-only compromise, not full machine access). `maskedKey` (e.g.
/// "sk-...ab12") is stored separately, in the clear, specifically so
/// listing credentials for display never needs to decrypt the real key —
/// decryption is reserved for the one place that actually calls the
/// provider.
model CloudModelCredential {
  id        String             @id @default(cuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id])
  provider  CloudModelProvider

  encryptedApiKey String
  maskedKey       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One credential per provider per company — setting a new key for a
  /// provider replaces (upserts) the existing row rather than
  /// accumulating stale ones.
  @@unique([companyId, provider])
  @@index([companyId])
}

/// Which document-attachment action an EcritureDocumentAuditLog row
/// records — see CLAUDE.md "Supporting-document attachments" (or the
/// implementation spec, if one exists) for why attach/replace/remove are
/// always allowed, even on an already-validated (immutable) écriture: a
/// document is metadata about an entry, never part of its balance, so it
/// never goes through assertDraft()/assertFiscalYearOpen() — this log is
/// what closes the resulting audit gap instead.
enum DocumentAuditAction {
  ATTACHED
  REPLACED
  REMOVED
}

/// A justificatif (invoice/receipt, PDF or image) attached to an
/// écriture. Pure metadata — never read by any balance/total/compliance
/// computation anywhere in this app. The file itself lives on local disk
/// under DOCUMENT_STORAGE_DIR/{companyId}/{this.id}.{ext}, never in this
/// table and never in any cloud storage — this app's own "local-first,
/// no cloud by default" stance (chat history, local-model inference)
/// applies to documents too. `storagePath` is relative to
/// DOCUMENT_STORAGE_DIR and built entirely from server-generated ids
/// (never the original filename), so there's no path-traversal surface
/// from a hostile upload name.
model EcritureDocument {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  ecritureId String
  /// onDelete: Cascade — EntriesService.remove() (drafts only, per the
  /// ledger-integrity rules) doesn't know about attached documents at all
  /// by design (see CLAUDE.md "Supporting-document attachments" for why
  /// EcritureDocumentsService is intentionally NOT a dependency of
  /// EntriesModule — the reverse direction would create a circular module
  /// dependency via AiChatModule). Without this, deleting a draft that
  /// happens to have a document attached would throw a raw foreign-key
  /// violation instead of a clean 500. The DB rows cascade cleanly; the
  /// on-disk file is a best-effort orphan in this rare path (a draft
  /// delete with a document already attached), matching the same
  /// "best-effort cleanup" discipline as deleteFileQuietly() elsewhere in
  /// this file's own service.
  ecriture   Ecriture @relation(fields: [ecritureId], references: [id], onDelete: Cascade)

  /// Original filename, for display only — never used to build the disk path.
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String

  uploadedAt DateTime @default(now())

  @@index([companyId, ecritureId])
}

/// Append-only log of every attach/replace/remove on an écriture's
/// documents — deliberately a SEPARATE table from EcritureDocument
/// itself, so history survives even after the document row a REMOVED
/// entry refers to is gone. `fileName` is a snapshot at the time of the
/// action, not a live reference. There is no "who" column: this app has
/// no authentication/user-identity model anywhere, so this log honestly
/// records only when and what, never a fabricated actor.
model EcritureDocumentAuditLog {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  ecritureId String
  action     DocumentAuditAction
  fileName   String
  occurredAt DateTime            @default(now())

  @@index([companyId, ecritureId])
}

/// A real, named bank account (see CLAUDE.md "Bank reconciliation"),
/// linked to exactly one 512/514-family PCG account. Before this model,
/// "the company's bank account" was implicit — whichever 512/514 Account
/// existed — which doesn't scale to a company with more than one real
/// account. One BankAccount per Account (@@unique) — the PCG account is
/// still the ledger's own source of truth for balances; this model only
/// adds the real-world identity (IBAN, label) statement import needs to
/// target.
model BankAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  compteId  String  @unique
  compte    Account @relation(fields: [compteId], references: [id])

  label    String
  iban     String?
  currency String  @default("EUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports BankStatementImport[]
  lines   BankStatementLine[]

  @@index([companyId])
}

/// One imported bank statement (CAMT.053 for v1 — see CLAUDE.md "Bank
/// reconciliation"). Deliberately mirrors ImportBatch's own role for
/// Excel import: a persisted record of the import itself, separate from
/// the individual statement lines it produced.
model BankStatementImport {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  fileName       String
  periodStart    DateTime
  periodEnd      DateTime
  openingBalance Decimal  @db.Decimal(15, 2)
  closingBalance Decimal  @db.Decimal(15, 2)
  importedAt     DateTime @default(now())

  lines BankStatementLine[]

  @@index([companyId, bankAccountId])
}

/// Which reconciliation state a BankStatementLine is in. UNMATCHED is
/// the only mutable-forward state — CONFIRMED can revert to UNMATCHED
/// via the explicit "clear match" action (never silently), IGNORED is a
/// deliberate terminal choice with its own optional reason.
enum BankStatementLineStatus {
  UNMATCHED
  CONFIRMED
  IGNORED
}

/// One parsed transaction line from an imported statement. `amount` is
/// SIGNED (positive = inflow, negative = outflow) — deliberately NOT the
/// always-positive debit/credit pair EcritureLigne uses, because a
/// statement line represents exactly one transaction, not a
/// multi-account split; following the bank's own natural representation
/// here is clearer than forcing EcritureLigne's convention onto a
/// different kind of object. Match PROPOSALS are never persisted (see
/// matching-engine.ts's own doc comment — recomputed fresh every time,
/// same "never persists" discipline as propose_ecriture) — only a
/// CONFIRMED match's result is, via `matchedLigneId`.
model BankStatementLine {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  importId      String
  import        BankStatementImport @relation(fields: [importId], references: [id])
  bankAccountId String
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])

  bookingDate   DateTime
  valueDate     DateTime?
  amount        Decimal   @db.Decimal(15, 2)
  label         String
  /// The bank's own transaction reference (CAMT AcctSvcrRef) — used to
  /// detect a re-imported statement's already-known lines at preview
  /// time, never silently re-imported as a duplicate.
  bankReference String?

  status BankStatementLineStatus @default(UNMATCHED)

  matchedLigneId String?        @unique
  matchedLigne   EcritureLigne? @relation(fields: [matchedLigneId], references: [id])
  ignoredReason  String?

  @@index([companyId, bankAccountId, status])
}

/// Which lettrage action a LettrageAuditLog row records.
enum LettrageAuditAction {
  SET
  CLEARED
}

/// Append-only log of every lettrage set/clear on an ALREADY-VALIDATED
/// écriture line — see CLAUDE.md "Bank reconciliation" for why this is
/// allowed at all (lettrage is reconciliation metadata, not part of an
/// entry's balance/compliance content, so it doesn't go through
/// assertDraft()) and why it's logged (the same audit discipline as
/// EcritureDocumentAuditLog — no "who", this app has no auth model).
/// A draft line's lettrage is NOT logged here — it's freely editable
/// like every other field on a draft, same as before this feature.
model LettrageAuditLog {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  ecritureLigneId String
  action          LettrageAuditAction
  lettrage        String?
  occurredAt      DateTime            @default(now())

  @@index([companyId, ecritureLigneId])
}
