// Prisma schema for the French/Monaco double-entry accounting suite.
//
// Every domain model carries companyId and is scoped per-company — see
// CLAUDE.md "Multi-tenant data model". All monetary fields are
// Decimal @db.Decimal(15, 2) — see CLAUDE.md "Money handling". Never widen
// a monetary field to Float/Real/Double.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR = France (Article A47 A-1 du LPF rules apply).
/// MC = Monaco (rules verified independently — see CLAUDE.md "Monaco compliance").
enum Jurisdiction {
  FR
  MC
}

/// Which liasse fiscale is this company's official/fileable one —
/// REEL_NORMAL (2050-series) or REEL_SIMPLIFIE (2033-series). Both remain
/// available as display views regardless of this value; it only selects
/// which one is authoritative. Same role as Jurisdiction for VAT: a real
/// schema field the liasse module branches on explicitly, not inferred —
/// see specs/liasse-2050-implementation-spec.md.
enum Regime {
  REEL_NORMAL
  REEL_SIMPLIFIE
}

enum JournalType {
  ACHATS
  VENTES
  BANQUE
  CAISSE
  OPERATIONS_DIVERSES
  A_NOUVEAU
}

/// SALE = a normal invoice. CREDIT_NOTE = an avoir, correcting a
/// finalized SALE invoice (Invoice.correctsInvoiceId) — see
/// specs/invoicing-phase-a-implementation-spec.md decision 2.
enum InvoiceType {
  SALE
  CREDIT_NOTE
}

/// TVA exigibilité regime for services (prestations de services, PCG
/// account 706) — CGI art. 269, 2-c: by default a service is taxable
/// "lors de l'encaissement" (payment collection), unless the taxable
/// person opts ("sur option du redevable") for exigibilité "d'après les
/// débits" (invoicing date) instead. Goods (livraisons de biens, every
/// other 70x account) are always exigible on delivery/invoicing and are
/// UNAFFECTED by this field — see invoice-posting.ts. FR only; inert
/// for an MC company (Monaco's own VAT regime symmetry with this rule is
/// unconfirmed — see CLAUDE.md "Monaco compliance").
enum RegimeTvaServices {
  ENCAISSEMENTS
  DEBITS
}

/// DRAFT = freely editable, no invoiceNumber/postedEcritureId yet.
/// FINALIZED = numbered and posted to the ledger, immutable — mirrors
/// Ecriture's own draft/validated split. Never transitions back to DRAFT.
enum InvoiceStatus {
  DRAFT
  FINALIZED
}

enum DepreciationMethod {
  LINEAR
  // Declining-balance (dégressif) coefficients are not yet implemented —
  // see CLAUDE.md and depreciation.service.ts. Do not select this value
  // from application code until the calculation is implemented.
  DECLINING
}

enum ImportStatus {
  PENDING
  COMMITTED
  FAILED
}

/// How often a RecurringEntryTemplate is expected to recur — purely
/// informational (feeds computeNextDueDate()'s "next due" hint in the
/// templates list), never drives auto-posting. See CLAUDE.md "Recurring
/// entries / templates" — v1 is on-demand apply only, no scheduler.
enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// USER = what the person typed. ASSISTANT = the local model's reply,
/// optionally carrying toolCalls it wants executed before it can finish
/// answering. TOOL = a tool call's result, fed back to the model as the
/// next turn. See CLAUDE.md "AI chatbot" — this is the exact shape
/// replayed to the local model on every turn, not a separate transcript
/// format.
enum ChatMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// Which cloud LLM provider a CloudModelCredential authenticates to — see
/// CLAUDE.md "AI chatbot cloud tier" and
/// specs/ai-chatbot-cloud-tier-implementation-spec.md. Deliberately only
/// the two providers with verified, cited residency/DPA terms; an
/// OpenAI-compatible custom-endpoint option is explicitly deferred (a
/// user-supplied endpoint can't carry a stated residency guarantee) — do
/// not add a value here for it without updating that spec first.
enum CloudModelProvider {
  CLAUDE
  DEEPSEEK
}

/// Which port actually produced an ASSISTANT/TOOL message — see CLAUDE.md
/// "AI chatbot cloud tier". LOCAL is the only value any code path sets
/// today (no cloud engine is wired into ChatOrchestratorService yet); the
/// field exists now so the always-visible per-message indicator has real,
/// persisted state to render the moment a cloud turn becomes possible,
/// rather than being retrofitted later. Never inferred from
/// `cloudProvider` being non-null — always set explicitly, together, by
/// whichever code path persists the message.
enum ChatEngine {
  LOCAL
  CLOUD
}

/// A tenant ("dossier"). The UI only ever shows one Company today, but the
/// schema is multi-tenant from day one — every other model scopes to a
/// companyId. See CLAUDE.md "Multi-tenant data model".
model Company {
  id           String       @id @default(cuid())
  name         String
  jurisdiction Jurisdiction

  /// Selects which liasse fiscale (2050-series vs. 2033-series) is this
  /// company's official/fileable one — see the Regime enum doc comment.
  /// Defaults to REEL_NORMAL (the regime this app's first liasse pass
  /// implements) so existing companies aren't left null.
  regime Regime @default(REEL_NORMAL)

  /// French SIREN (9 digits). Required to produce a FEC export for a FR company.
  siren String?

  /// Monaco RCI (Registre du Commerce et de l'Industrie) identifier.
  rci String?

  vatNumber String?

  /// Structured, not free-text: the liasse fiscale / CERFA forms on the
  /// roadmap expect discrete address components, so this avoids parsing a
  /// blob later once real data exists.
  addressLine String?
  postalCode  String?
  city        String?
  country     String  @default("France")

  /// See RegimeTvaServices doc comment (CGI art. 269). Defaults to the
  /// legal default (ENCAISSEMENTS) so an existing company isn't silently
  /// switched to DEBITS by this migration.
  regimeTvaServices RegimeTvaServices @default(ENCAISSEMENTS)

  /// Payment instructions shown on devis/facture PDFs and (when set)
  /// the Factur-X CII payment-means block — see invoice-mentions.ts's
  /// `paymentInstructions` and invoice-to-cii.ts. All three null
  /// together means "not configured" — the PDF/CII layers omit the
  /// block entirely rather than showing a placeholder ("flag, don't
  /// fake" — see CLAUDE.md).
  bankName String?
  iban     String?
  bic      String?

  /// Next value to assign as Ecriture.ecritureNum (single global sequence —
  /// see CLAUDE.md "Ledger integrity" and EntriesService.validate). Never
  /// derive "next number" from MAX(ecritureNum) once ecritureNum is a
  /// String: lexical ordering breaks past 9 entries ("10" < "2"). This
  /// counter is incremented atomically inside the validation transaction.
  nextEcritureNum Int @default(1)

  /// Next value to assign as Invoice.invoiceNumber — a SEPARATE sequence
  /// from nextEcritureNum (an invoice number and its posting écriture's
  /// own number are legally distinct identifiers). Assigned only at
  /// finalize(), never at draft creation — see
  /// specs/invoicing-phase-a-implementation-spec.md decision 1. Shared by
  /// both SALE and CREDIT_NOTE invoices (decision 2).
  nextInvoiceNum Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fiscalYears           FiscalYear[]
  accounts              Account[]
  journals              Journal[]
  ecritures             Ecriture[]
  ecritureLignes        EcritureLigne[]
  fixedAssets           FixedAsset[]
  depreciationEntries   DepreciationEntry[]
  vatRates              VatRate[]
  importBatches         ImportBatch[]
  chatSessions          ChatSession[]
  chatMessages          ChatMessage[]
  cloudModelCredentials CloudModelCredential[]
  ecritureDocuments     EcritureDocument[]
  ecritureDocumentLogs  EcritureDocumentAuditLog[]
  bankAccounts          BankAccount[]
  bankStatementImports  BankStatementImport[]
  bankStatementLines    BankStatementLine[]
  lettrageAuditLogs     LettrageAuditLog[]
  bankAggregatorLinks   BankAggregatorLink[]
  invoices              Invoice[]
  invoiceLines          InvoiceLine[]
  recurringEntryTemplates RecurringEntryTemplate[]
  memberships           Membership[]
  companyInvites        CompanyInvite[]
  activityEvents        ActivityEvent[]
}

/// Exercice comptable. Ecritures are validated (locked) relative to a
/// fiscal year's close, and FEC exports are always for exactly one
/// fiscal year.
model FiscalYear {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label     String
  startDate DateTime
  endDate   DateTime
  closedAt  DateTime?

  ecritures           Ecriture[]
  depreciationEntries DepreciationEntry[]
  invoices            Invoice[]

  @@unique([companyId, label])
  @@index([companyId])
}

/// Compte (PCG chart-of-accounts entry). Number-to-class validation
/// (leading digit -> PCG class 1-8) is enforced in the accounts service,
/// not the schema, so it can produce a clear domain error.
model Account {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// CompteNum in FEC terms.
  number String
  /// CompteLib in FEC terms.
  label  String

  /// Leading digit of `number`, i.e. the PCG class (1-8).
  pcgClass Int

  /// True for a compte auxiliaire (e.g. a specific client/supplier
  /// sub-account referenced from an EcritureLigne as CompAuxNum/CompAuxLib).
  isAuxiliary Boolean @default(false)

  parentId String?
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  linesAsMain EcritureLigne[] @relation("EcritureLigneCompte")
  linesAsAux  EcritureLigne[] @relation("EcritureLigneCompteAux")

  fixedAssetsAsAsset        FixedAsset[] @relation("FixedAssetAccount")
  fixedAssetsAsDepreciation FixedAsset[] @relation("FixedAssetDepreciationAccount")
  fixedAssetsAsExpense      FixedAsset[] @relation("FixedAssetExpenseAccount")

  bankAccount BankAccount?

  invoicesAsClient      Invoice[]
  invoiceLinesAsRevenue InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
}

/// Journal comptable (JournalCode / JournalLib in FEC terms).
model Journal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code  String
  label String
  type  JournalType

  ecritures Ecriture[]
  recurringEntryTemplates RecurringEntryTemplate[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Écriture comptable (journal entry). See CLAUDE.md "Ledger integrity"
/// for the invariants that must hold before/at validation:
/// balance, sequential numbering, immutability once validated.
model Ecriture {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  journalId    String
  journal      Journal    @relation(fields: [journalId], references: [id])

  /// EcritureNum: assigned only at validation time, sequential and gapless
  /// per company. Null while the entry is a draft. String rather than Int
  /// so a future per-journal numbering scheme can use alphanumeric values
  /// (Art. A47 A-1 du LPF §100 shows both a global numeric sequence and a
  /// per-journal alphanumeric one — e.g. "AN0001" — as equally valid).
  /// The "next number" is tracked via Company.nextEcritureNum, not derived
  /// from this column, so lexical string ordering is never load-bearing.
  ecritureNum String?

  /// EcritureDate.
  ecritureDate DateTime

  /// PieceRef / PieceDate: reference to the supporting document.
  pieceRef  String?
  pieceDate DateTime?

  /// EcritureLib.
  libelle String

  /// ValidDate. Null = draft (editable). Set = immutable; corrections must
  /// be posted as a new reversing entry referencing this one.
  validatedAt DateTime?

  /// Set when this entry reverses/corrects another validated entry
  /// (contre-passation / extourne).
  reversesId String?
  reverses   Ecriture?  @relation("EcritureReversal", fields: [reversesId], references: [id])
  reversedBy Ecriture[] @relation("EcritureReversal")

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  lignes    EcritureLigne[]
  documents EcritureDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // EcritureNum is only meaningful once assigned, but must be unique per
  // company when present.
  @@unique([companyId, ecritureNum])
  @@index([companyId, fiscalYearId])
  @@index([companyId, journalId])
}

/// Ligne d'écriture. Exactly one of debit/credit is non-zero — enforced in
/// the entries service (see CLAUDE.md rule 4), not expressible in SQL alone.
model EcritureLigne {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  ecritureId String
  ecriture   Ecriture @relation(fields: [ecritureId], references: [id])

  compteId String
  compte   Account @relation("EcritureLigneCompte", fields: [compteId], references: [id])

  /// Compte auxiliaire (CompAuxNum/CompAuxLib), e.g. a specific client/supplier.
  compteAuxId String?
  compteAux   Account? @relation("EcritureLigneCompteAux", fields: [compteAuxId], references: [id])

  debit  Decimal @default(0) @db.Decimal(15, 2)
  credit Decimal @default(0) @db.Decimal(15, 2)

  /// EcritureLet / DateLet: lettrage (reconciliation) marker.
  lettrage     String?
  dateLettrage DateTime?

  /// Montantdevise / Idevise: original amount and currency for foreign-currency lines.
  montantDevise Decimal? @db.Decimal(15, 2)
  idDevise      String?

  /// The rate this line is taxed/taxable at, for VAT declaration purposes
  /// (see src/modules/vat/ca3-declaration.ts). Tags both the TVA line
  /// itself (a 4457x collectée account) and the corresponding revenue
  /// line at the same rate — one line-level tag drives both the
  /// collectée-by-rate and the base-HT-by-rate aggregation, rather than
  /// proliferating rate sub-accounts. Null on lines with no VAT relevance
  /// (bank, tiers, ...) and on historical lines predating this field —
  /// computeDeclaration() refuses to compute a period containing an
  /// untagged line on a VAT account rather than silently omitting it.
  vatRateId String?
  vatRate   VatRate? @relation(fields: [vatRateId], references: [id])

  /// Due date for a créance/dette line — feeds the 2057 (état des
  /// échéances) maturity split (see tableau-2057.ts). Optional: most
  /// lines (charges, produits, immobilisations, trésorerie) have no
  /// notion of a due date at all. A créance/dette line with no value
  /// here falls into 2057's documented default bucket rather than
  /// being guessed.
  dateEcheance DateTime?

  createdAt DateTime @default(now())

  /// The bank-statement line this ligne was reconciled against, if any —
  /// see CLAUDE.md "Bank reconciliation". Optional: most lignes are never
  /// bank-matched (only ones on a 512/514-family account typically are).
  bankStatementMatch BankStatementLine?

  @@index([companyId, ecritureId])
  @@index([companyId, compteId])
}

/// Immobilisation (fixed asset) for the depreciation module. Only
/// straight-line (LINEAR) amortization is implemented so far.
model FixedAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label                 String
  accountId             String
  account               Account @relation("FixedAssetAccount", fields: [accountId], references: [id])
  depreciationAccountId String
  depreciationAccount   Account @relation("FixedAssetDepreciationAccount", fields: [depreciationAccountId], references: [id])
  expenseAccountId      String
  expenseAccount        Account @relation("FixedAssetExpenseAccount", fields: [expenseAccountId], references: [id])

  acquisitionDate  DateTime
  serviceStartDate DateTime
  acquisitionValue Decimal            @db.Decimal(15, 2)
  residualValue    Decimal            @default(0) @db.Decimal(15, 2)
  usefulLifeYears  Int
  method           DepreciationMethod @default(LINEAR)

  /// Cession (disposal) — real since 2026-08-15, see
  /// DepreciationService.disposeFixedAsset(). All three fields stay null
  /// until an asset is actually disposed.
  cessionDate       DateTime?
  cessionPrice      Decimal?  @db.Decimal(15, 2)
  /// The écriture disposeFixedAsset() posted for this disposal — a bare
  /// nullable id, no @relation, same shape as DepreciationEntry's own
  /// postedEcritureId. Added 2026-08-29 for the traceability drill-down's
  /// Tier 3 (2059-A) — before this, tracing a 2059-A row would have meant
  /// *searching* écritures by account+date+amount, which this app's own
  /// "never guess" discipline rejects.
  cessionEcritureId String?

  depreciationEntries DepreciationEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// One year's depreciation schedule line (dotation aux amortissements) for
/// a FixedAsset, optionally linked to the Ecriture that posted it.
model DepreciationEntry {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  fixedAssetId String
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id])
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])

  amount Decimal @db.Decimal(15, 2)

  postedEcritureId String?

  createdAt DateTime @default(now())

  @@unique([fixedAssetId, fiscalYearId])
  @@index([companyId])
}

/// Taux de TVA applicable for a company/jurisdiction over a date range.
/// Populated per-company because Monaco rates must be verified
/// independently rather than assumed identical to France — see CLAUDE.md.
model VatRate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  label       String
  ratePercent Decimal   @db.Decimal(5, 2)
  validFrom   DateTime
  validTo     DateTime?

  ecritureLignes EcritureLigne[]
  invoiceLines   InvoiceLine[]
  recurringEntryTemplateLines RecurringEntryTemplateLine[]

  @@index([companyId])
}

/// A committed Excel journal import. Ecritures created from an import are
/// drafts (unvalidated) until reviewed and validated like any other entry.
model ImportBatch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  fileName String
  status   ImportStatus @default(PENDING)
  errors   Json?

  ecritures Ecriture[]

  createdAt DateTime @default(now())
}

/// A local-only chat conversation with the AI assistant — see CLAUDE.md
/// "AI chatbot". Company-scoped like every domain table; nothing in this
/// table or its ChatMessage children is ever sent anywhere but the local
/// model this company's AiChatModule talks to (see LocalModelPort), UNLESS
/// a cloud proposal thread is explicitly open (see the two fields below and
/// CLAUDE.md "AI chatbot cloud tier" — "server-side thread/granularity
/// enforcement").
model ChatSession {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// First ~60 chars of the opening user message — a label for the session
  /// list. Never re-derived by an extra model call just to name a session.
  title String?

  /// Non-null while a bounded cloud-proposal thread is open on this
  /// session — the server-side half of "granularity: per-invocation,
  /// bounded to one proposal thread" (see cloud-thread-gate.ts and
  /// CLAUDE.md "AI chatbot cloud tier"). Opened only by a turn that
  /// supplies `cloudProvider` AND attaches a file to propose from; cleared
  /// the instant the thread reverts to local — an explicit "Revenir au
  /// local" action, or the next LOCAL-engine message sent in this session
  /// (AiChatService.sendMessage()'s local branch always clears it, whether
  /// or not one was open). A random id, not a foreign key to anything —
  /// it exists purely to gate "is cloud still legitimately open here",
  /// never referenced elsewhere.
  cloudProposalThreadId String?

  /// Which provider `cloudProposalThreadId` is bound to. Null whenever
  /// cloudProposalThreadId is null; the two are always set/cleared
  /// together, never independently. A thread may only continue for the
  /// SAME provider it was opened with — see decideCloudThread()'s own doc
  /// comment for why switching provider mid-thread is refused rather than
  /// silently reassigned.
  cloudProposalProvider CloudModelProvider?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([companyId])
}

/// One turn in a ChatSession's message list. This is deliberately the
/// exact shape replayed to the local model on every turn (see
/// chat-orchestrator.service.ts), not a separate transcript format.
model ChatMessage {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])

  role    ChatMessageRole
  content String          @db.Text

  /// Present only on an ASSISTANT message that requested one or more tool
  /// calls before it could finish answering — [{ id, name, arguments }].
  toolCalls Json?

  /// Present only on a TOOL message: which tool produced this result, and
  /// which tool-call id it answers — lets the trace render ("query_ca3 →
  /// {...}") without re-parsing toolCalls off the preceding assistant row.
  toolName   String?
  toolCallId String?

  /// Which port produced this message — see the ChatEngine enum's own doc
  /// comment. Defaults to LOCAL because every existing row, and every
  /// write path today, is local; CLOUD is not yet reachable.
  engine ChatEngine @default(LOCAL)

  /// Set only when engine is CLOUD — which provider. Null on every LOCAL
  /// row. `engine` itself is set on every row including USER (defaults to
  /// LOCAL, since it's a required column) even though a user's own typed
  /// message wasn't "produced by" any port — the frontend's per-message
  /// badge simply never renders one for the USER role, regardless of the
  /// stored value.
  cloudProvider CloudModelProvider?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([companyId])
}

/// A company's own (BYO) API key for one cloud LLM provider — used ONLY
/// by the propose_ecriture write path (see CLAUDE.md "AI chatbot cloud
/// tier"). Cloud is opt-in, never default: a row here only exists once a
/// user has explicitly completed the consent flow for that provider.
///
/// `encryptedApiKey` is ciphertext (AES-256-GCM, see
/// src/common/crypto/credential-encryption.service.ts), never plaintext.
/// The decryption key lives OUTSIDE this database entirely
/// (CLOUD_CREDENTIAL_ENCRYPTION_KEY) — that file's own doc comment states
/// the real threat model this defends against (a leaked DB backup or
/// DB-only compromise, not full machine access). `maskedKey` (e.g.
/// "sk-...ab12") is stored separately, in the clear, specifically so
/// listing credentials for display never needs to decrypt the real key —
/// decryption is reserved for the one place that actually calls the
/// provider.
model CloudModelCredential {
  id        String             @id @default(cuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id])
  provider  CloudModelProvider

  encryptedApiKey String
  maskedKey       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One credential per provider per company — setting a new key for a
  /// provider replaces (upserts) the existing row rather than
  /// accumulating stale ones.
  @@unique([companyId, provider])
  @@index([companyId])
}

/// Which document-attachment action an EcritureDocumentAuditLog row
/// records — see CLAUDE.md "Supporting-document attachments" (or the
/// implementation spec, if one exists) for why attach/replace/remove are
/// always allowed, even on an already-validated (immutable) écriture: a
/// document is metadata about an entry, never part of its balance, so it
/// never goes through assertDraft()/assertFiscalYearOpen() — this log is
/// what closes the resulting audit gap instead.
enum DocumentAuditAction {
  ATTACHED
  REPLACED
  REMOVED
}

/// A justificatif (invoice/receipt, PDF or image) attached to an
/// écriture. Pure metadata — never read by any balance/total/compliance
/// computation anywhere in this app. The file itself lives on local disk
/// under DOCUMENT_STORAGE_DIR/{companyId}/{this.id}.{ext}, never in this
/// table and never in any cloud storage — this app's own "local-first,
/// no cloud by default" stance (chat history, local-model inference)
/// applies to documents too. `storagePath` is relative to
/// DOCUMENT_STORAGE_DIR and built entirely from server-generated ids
/// (never the original filename), so there's no path-traversal surface
/// from a hostile upload name.
model EcritureDocument {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  ecritureId String
  /// onDelete: Cascade — EntriesService.remove() (drafts only, per the
  /// ledger-integrity rules) doesn't know about attached documents at all
  /// by design (see CLAUDE.md "Supporting-document attachments" for why
  /// EcritureDocumentsService is intentionally NOT a dependency of
  /// EntriesModule — the reverse direction would create a circular module
  /// dependency via AiChatModule). Without this, deleting a draft that
  /// happens to have a document attached would throw a raw foreign-key
  /// violation instead of a clean 500. The DB rows cascade cleanly; the
  /// on-disk file is a best-effort orphan in this rare path (a draft
  /// delete with a document already attached), matching the same
  /// "best-effort cleanup" discipline as deleteFileQuietly() elsewhere in
  /// this file's own service.
  ecriture   Ecriture @relation(fields: [ecritureId], references: [id], onDelete: Cascade)

  /// Original filename, for display only — never used to build the disk path.
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String

  uploadedAt DateTime @default(now())

  @@index([companyId, ecritureId])
}

/// Append-only log of every attach/replace/remove on an écriture's
/// documents — deliberately a SEPARATE table from EcritureDocument
/// itself, so history survives even after the document row a REMOVED
/// entry refers to is gone. `fileName` is a snapshot at the time of the
/// action, not a live reference. There is no "who" column: this app has
/// no authentication/user-identity model anywhere, so this log honestly
/// records only when and what, never a fabricated actor.
model EcritureDocumentAuditLog {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  ecritureId String
  action     DocumentAuditAction
  fileName   String
  occurredAt DateTime            @default(now())

  @@index([companyId, ecritureId])
}

/// A real, named bank account (see CLAUDE.md "Bank reconciliation"),
/// linked to exactly one 512/514-family PCG account. Before this model,
/// "the company's bank account" was implicit — whichever 512/514 Account
/// existed — which doesn't scale to a company with more than one real
/// account. One BankAccount per Account (@@unique) — the PCG account is
/// still the ledger's own source of truth for balances; this model only
/// adds the real-world identity (IBAN, label) statement import needs to
/// target.
model BankAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  compteId  String  @unique
  compte    Account @relation(fields: [compteId], references: [id])

  label    String
  iban     String?
  currency String  @default("EUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  imports        BankStatementImport[]
  lines          BankStatementLine[]
  aggregatorLink BankAggregatorLink?

  @@index([companyId])
}

/// Which live bank-aggregator this app talks to — see CLAUDE.md "Bank
/// reconciliation — Layer 1b". Bridge only for v1; the enum exists
/// (rather than a bare string) so a second provider (e.g. Powens) is a
/// new case, not a schema change, matching CloudModelProvider's own
/// growth pattern.
enum BankAggregatorProvider {
  BRIDGE
}

/// ACTIVE is the only state new syncs run against. REVOKED means
/// BankAggregatorPort.revoke() has already been called against the
/// provider (see bank-aggregator-link.service.ts) — the row is kept,
/// not deleted, as a historical record that a live link once existed
/// here, same "don't delete, mark" instinct as BankStatementLineStatus.
/// ERROR is set when a sync call fails in a way that likely means the
/// link itself needs re-authorizing (e.g. the bank revoked consent on
/// its own side), distinct from an ordinary transient network error.
enum BankAggregatorLinkStatus {
  ACTIVE
  REVOKED
  ERROR
}

/// A live, provider-managed connection to one real bank account,
/// replacing manual CAMT.053 upload as this BankAccount's statement
/// source — see CLAUDE.md "Bank reconciliation — Layer 1b". Deliberately
/// keyed to an existing BankAccount (1a), not a new parallel "account"
/// concept: a live link only changes HOW that account's
/// BankStatementLine rows arrive (via BankAggregatorLinkService.syncNow(),
/// which still calls the same BankStatementImportService persistence
/// path 1a's manual upload already uses), never what happens once they
/// do — the matching engine and review UI are completely unaware this
/// model exists.
///
/// `encryptedAccessToken` is ciphertext (AES-256-GCM, via the SAME
/// CredentialEncryptionService/CLOUD_CREDENTIAL_ENCRYPTION_KEY the cloud
/// AI tier's CloudModelCredential already uses — reused verbatim, not a
/// parallel encryption scheme, per this feature's own design pass). This
/// is Bridge's own per-connection access token (obtained via its Connect
/// flow), NOT this deployment's app-level Bridge client_id/client_secret
/// — those live in backend/.env only, never in this table, since they're
/// this app's own registered identity with Bridge, shared across every
/// company, not a per-company secret.
model BankAggregatorLink {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  bankAccountId String      @unique
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  provider             BankAggregatorProvider
  /// The provider's own id for this bank connection (Bridge calls this
  /// an "Item").
  externalItemId       String
  encryptedAccessToken String
  /// Never a real API-key-style hint ("sk-...ab12") — a bank connection
  /// has no key to mask this way. Holds a short, human-meaningful label
  /// instead (e.g. the linked bank's own name, if the provider returns
  /// one), purely for display.
  maskedAccessToken    String

  status       BankAggregatorLinkStatus @default(ACTIVE)
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider, externalItemId])
  @@index([companyId])
}

/// One imported bank statement (CAMT.053 for v1 — see CLAUDE.md "Bank
/// reconciliation"). Deliberately mirrors ImportBatch's own role for
/// Excel import: a persisted record of the import itself, separate from
/// the individual statement lines it produced.
model BankStatementImport {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  fileName       String
  periodStart    DateTime
  periodEnd      DateTime
  /// Null for a CSV import (see CsvStatementParserService) — a bank CSV
  /// export commonly carries no opening/closing balance fields at all,
  /// unlike CAMT.053's own OPBD/CLBD, so there is nothing honest to
  /// reconcile against. Always non-null for a CAMT.053 or Bridge-synced
  /// import, both of which DO carry a real balance oracle
  /// (assertBalancesReconcile()) — see CLAUDE.md "Bank reconciliation".
  openingBalance Decimal? @db.Decimal(15, 2)
  closingBalance Decimal? @db.Decimal(15, 2)
  importedAt     DateTime @default(now())

  lines BankStatementLine[]

  @@index([companyId, bankAccountId])
}

/// Which reconciliation state a BankStatementLine is in. UNMATCHED is
/// the only mutable-forward state — CONFIRMED can revert to UNMATCHED
/// via the explicit "clear match" action (never silently), IGNORED is a
/// deliberate terminal choice with its own optional reason.
enum BankStatementLineStatus {
  UNMATCHED
  CONFIRMED
  IGNORED
}

/// One parsed transaction line from an imported statement. `amount` is
/// SIGNED (positive = inflow, negative = outflow) — deliberately NOT the
/// always-positive debit/credit pair EcritureLigne uses, because a
/// statement line represents exactly one transaction, not a
/// multi-account split; following the bank's own natural representation
/// here is clearer than forcing EcritureLigne's convention onto a
/// different kind of object. Match PROPOSALS are never persisted (see
/// matching-engine.ts's own doc comment — recomputed fresh every time,
/// same "never persists" discipline as propose_ecriture) — only a
/// CONFIRMED match's result is, via `matchedLigneId`.
model BankStatementLine {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  importId      String
  import        BankStatementImport @relation(fields: [importId], references: [id])
  bankAccountId String
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id])

  bookingDate   DateTime
  valueDate     DateTime?
  amount        Decimal   @db.Decimal(15, 2)
  label         String
  /// The bank's own transaction reference (CAMT AcctSvcrRef) — used to
  /// detect a re-imported statement's already-known lines at preview
  /// time, never silently re-imported as a duplicate.
  bankReference String?

  status BankStatementLineStatus @default(UNMATCHED)

  matchedLigneId String?        @unique
  matchedLigne   EcritureLigne? @relation(fields: [matchedLigneId], references: [id])
  ignoredReason  String?

  @@index([companyId, bankAccountId, status])
}

/// Which lettrage action a LettrageAuditLog row records.
enum LettrageAuditAction {
  SET
  CLEARED
}

/// Append-only log of every lettrage set/clear on an ALREADY-VALIDATED
/// écriture line — see CLAUDE.md "Bank reconciliation" for why this is
/// allowed at all (lettrage is reconciliation metadata, not part of an
/// entry's balance/compliance content, so it doesn't go through
/// assertDraft()) and why it's logged (the same audit discipline as
/// EcritureDocumentAuditLog — no "who", this app has no auth model).
/// A draft line's lettrage is NOT logged here — it's freely editable
/// like every other field on a draft, same as before this feature.
model LettrageAuditLog {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  ecritureLigneId String
  action          LettrageAuditAction
  lettrage        String?
  occurredAt      DateTime            @default(now())

  @@index([companyId, ecritureLigneId])
}

/// Invoicing — Phase A (compliant generation + gated ledger posting).
/// See specs/invoicing-plan.md and
/// specs/invoicing-phase-a-implementation-spec.md for the full design.
/// A DRAFT invoice is freely editable and has no legal existence yet
/// (no invoiceNumber, no posted écriture). finalize() — jurisdiction-
/// branching, France implemented, Monaco an explicit pending stub —
/// assigns invoiceNumber/invoiceDate, snapshots the client's legal-
/// mention fields, posts a real balanced écriture via the ordinary
/// EntriesService path, and flips status to FINALIZED. Never
/// transitions back to DRAFT; a correction is a CREDIT_NOTE invoice,
/// never an edit.
model Invoice {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])

  type   InvoiceType   @default(SALE)
  status InvoiceStatus @default(DRAFT)

  /// Assigned only at finalize(), from Company.nextInvoiceNum — see
  /// decision 1. Null while DRAFT.
  invoiceNumber String?
  /// Issue date, set at finalize() time.
  invoiceDate   DateTime?

  /// The client this invoice bills — an existing 411-family auxiliary
  /// Account (Tiers), never invented ad hoc here — see decision 5.
  clientAccountId String
  clientAccount   Account @relation(fields: [clientAccountId], references: [id])

  /// Snapshot of the client's legal-mention fields AT finalize() time —
  /// an invoice's printed content must never retroactively change if
  /// the underlying tiers record is edited later. Null while DRAFT.
  /// Address is STRUCTURED (mirroring Company's own addressLine/
  /// postalCode/city fields), not a single free-text string — added
  /// 2026-08-31 when the Factur-X CII renderer needed a real structured
  /// buyer address (EN16931 Schematron BR-8/BR-9 require at least a
  /// country code for both seller and buyer); a free-text address
  /// string can't honestly be parsed into that without guessing, so the
  /// field was fixed at the source instead. clientCountrySnapshot holds
  /// an ISO 3166-1 alpha-2 CODE (e.g. "FR"), NOT a display name —
  /// deliberately different from Company.country (a free-text display
  /// name, e.g. "France") so no name↔code mapping/guessing is ever
  /// needed; the seller's own CII country code is derived directly from
  /// Company.jurisdiction instead (FR/MC already ARE the ISO codes).
  clientNameSnapshot        String?
  clientAddressLineSnapshot String?
  clientPostalCodeSnapshot  String?
  clientCitySnapshot        String?
  clientCountrySnapshot     String?
  clientSirenOrRci          String?
  clientVatNumber           String?

  /// Required, and must reference a FINALIZED SALE invoice (enforced in
  /// the service layer), when type = CREDIT_NOTE. Null for a SALE.
  correctsInvoiceId String?
  correctsInvoice   Invoice?  @relation("InvoiceCorrection", fields: [correctsInvoiceId], references: [id])
  correctedBy       Invoice[] @relation("InvoiceCorrection")

  /// The écriture finalize() posted — set alongside invoiceNumber. See
  /// decision 1's accepted-risk note (same two-step shape as
  /// FixedAsset.cessionEcritureId). Null while DRAFT.
  postedEcritureId String?

  /// TVA sur les encaissements (CGI art. 269) — see
  /// InvoicingService.markAsEncaisse(). Null until a human explicitly
  /// confirms the WHOLE invoice was paid (no partial-payment proration
  /// this pass); only meaningful for a SALE invoice with at least one
  /// 706-class (services) line finalized under
  /// Company.regimeTvaServices = ENCAISSEMENTS. Deliberately NOT a new
  /// InvoiceStatus value — this is VAT-exigibility metadata, orthogonal
  /// to the DRAFT/FINALIZED document lifecycle.
  encaissementConfirmedAt DateTime?
  /// The débit-445800/crédit-445710 reclassification écriture
  /// markAsEncaisse() posted — same two-step accepted-risk shape as
  /// postedEcritureId itself. Null until set alongside
  /// encaissementConfirmedAt.
  encaissementEcritureId  String?

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // invoiceNumber is only meaningful once assigned, but must be unique
  // per company when present — same pattern as Ecriture.ecritureNum.
  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, fiscalYearId])
}

/// One line item on an Invoice — quantity/unit-price-HT/VAT-rate, the
/// inputs computeInvoiceMentions()/buildInvoicePostingLignes() both
/// consume. Quantity is Decimal, not a native number, matching this
/// app's blanket money-handling rule (it feeds a money computation:
/// quantity × unitPriceHT).
model InvoiceLine {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  description String
  quantity    Decimal @db.Decimal(15, 2)
  unitPriceHT Decimal @db.Decimal(15, 2)

  /// The class-7 revenue account this line posts to (707/706-family) —
  /// caller-chosen per line, same as a manual écriture line always
  /// names its own account.
  revenueAccountId String
  revenueAccount   Account @relation(fields: [revenueAccountId], references: [id])

  /// Null = VAT-exempt line (no TVA ligne posted for it) — never
  /// guessed, same "untagged collectée line" discipline as
  /// ca3-declaration.ts.
  vatRateId String?
  vatRate   VatRate? @relation(fields: [vatRateId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, invoiceId])
}

/// A saved template for a repeating écriture (rent, a subscription, a
/// loan installment) — see CLAUDE.md "Recurring entries / templates".
/// Pure metadata: a template never itself becomes part of the ledger
/// (unlike Journal/Account/VatRate/FiscalYear, referenced forever by
/// immutable écritures), so it's safe to hard-delete. `journalId` is
/// stored directly (Journal has no delete/update endpoint at all, so a
/// raw id is exactly as stable as a code lookup); each line's account is
/// instead resolved by NUMBER at apply-time (see
/// RecurringEntriesService.previewApplication()), matching this app's own
/// established idiom for system-composed écritures
/// (DepreciationService.requireAccountByNumber(),
/// a-nouveau.service.ts's account-by-number lookups) rather than a raw,
/// harder-to-audit id. `frequency`/`anchorDay`/`anchorMonth` are
/// PURELY informational (feed computeNextDueDate()'s "next due" hint) —
/// applying a template is always an explicit, on-demand human action
/// (POST .../preview then the ordinary POST /entries), never
/// auto-posted on a schedule; there is no scheduler in this app.
model RecurringEntryTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name      String
  journalId String
  journal   Journal @relation(fields: [journalId], references: [id])
  libelle   String

  frequency   RecurrenceFrequency?
  /// Day-of-month (1-31) the template is expected to recur on. For
  /// QUARTERLY/YEARLY this is the day-of-month WITHIN anchorMonth.
  anchorDay   Int?
  /// 1-12. Only meaningful for QUARTERLY (month-within-quarter, 1-3) or
  /// YEARLY (calendar month, 1-12) — null for MONTHLY.
  anchorMonth Int?

  /// Stamped by the explicit POST .../mark-applied call, right after the
  /// frontend's own useCreateEcriture() succeeds for a draft built from
  /// this template — purely a "next due" reminder input, not an audit
  /// trail (a template can be applied many times; no link to which
  /// écriture(s) resulted is kept here).
  lastAppliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines RecurringEntryTemplateLine[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// One line of a RecurringEntryTemplate. `accountNumber`/`auxAccountNumber`
/// are PCG account NUMBERS, resolved to a live Account at apply-time —
/// see RecurringEntryTemplate's own doc comment for why. Exactly one of
/// debit/credit is non-zero, same invariant as EcritureLigne, enforced in
/// the service layer (not expressible in SQL alone).
model RecurringEntryTemplateLine {
  id         String                 @id @default(cuid())
  templateId String
  template   RecurringEntryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// Preserves the line's position in the editor grid.
  order Int

  accountNumber    String
  auxAccountNumber String?

  vatRateId String?
  vatRate   VatRate? @relation(fields: [vatRateId], references: [id])

  debit  Decimal @default(0) @db.Decimal(15, 2)
  credit Decimal @default(0) @db.Decimal(15, 2)

  @@index([templateId])
}

/// A real account able to sign in — see CLAUDE.md "Multi-user / roles &
/// permissions". `email` is always stored LOWERCASED (the enforced
/// invariant everywhere it's read/written, since Postgres has no
/// case-insensitive-unique primitive without the citext extension, not
/// worth adding for this). `passwordHash` is bcrypt, never anything
/// reversible — a User has no direct company access of its own; every
/// company relationship goes through Membership.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  sentInvites    CompanyInvite[]
}

/// Coarse per-company access level — see CLAUDE.md "Multi-user / roles &
/// permissions" for why this is deliberately NOT a fine-grained
/// permission-table shape (that's an explicitly deferred later phase;
/// building the extensibility hook now would be dead weight). OWNER can
/// manage members/roles and everything a MEMBER can; MEMBER can post/
/// validate/edit business data; READ_ONLY is blocked from any non-GET/
/// HEAD request by ReadOnlyGuard, enforced once, generically, for the
/// entire existing controller surface.
enum MembershipRole {
  OWNER
  MEMBER
  READ_ONLY
}

/// The User↔Company join — one shape that covers BOTH named use cases at
/// once: an accountant serving several clients is just a user with
/// several memberships; a team within one company is just several users
/// each with a membership in that one company. See
/// CompanyContextMiddleware, which resolves this per-request to attach
/// {companyId, role} to req.companyContext.
model Membership {
  id        String         @id @default(cuid())
  userId    String
  companyId String
  role      MembershipRole

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Refresh-token rotation with reuse-detection — see CLAUDE.md
/// "Multi-user / roles & permissions". The raw opaque token is NEVER
/// stored; only its SHA-256 hash. `familyId` groups one login's entire
/// rotation chain: presenting an already-`revokedAt` token (a replayed,
/// stolen token) revokes every row sharing that familyId, not just the
/// one presented — real reuse-detection, not just single-token
/// revocation. `replacedById` points forward to the row that superseded
/// this one on a successful rotation.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// A one-time password-reset link's token, hashed at rest like
/// RefreshToken (never store the raw token). `usedAt` makes it single-use;
/// a request for a NEW reset simply creates a new row — an old, unused
/// row is left to expire naturally rather than being explicitly revoked
/// (harmless: whichever the user actually clicks wins, and an expired or
/// already-used one is rejected).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Invites someone (by email — they may or may not have a User account
/// yet) to join a company at a given role. Accepting one (via the
/// emailed token) either creates a brand-new User + Membership, or, if
/// that email already has an account, just adds the Membership — see
/// AuthService/MembershipsService. tokenHash follows the same
/// never-store-the-raw-token discipline as RefreshToken/
/// PasswordResetToken.
model CompanyInvite {
  id         String         @id @default(cuid())
  companyId  String
  email      String
  role       MembershipRole
  tokenHash  String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())

  invitedByUserId String
  invitedBy       User    @relation(fields: [invitedByUserId], references: [id])
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

/// The kinds of team/membership actions the activity feed surfaces — see
/// CLAUDE.md "Activity feed" for why this is scoped to team actions only
/// this pass, not a generic audit log of every write in the app.
enum ActivityEventType {
  MEMBER_INVITED
  MEMBER_INVITE_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

/// A lightweight, append-only trail of team/membership actions for a
/// company — see CLAUDE.md "Activity feed". Deliberately NOT a generic
/// audit log of every write this app makes (a much larger, separately-
/// scoped project — see ActivityService's own doc comment) and
/// deliberately NOT a live FK to User: actorEmail/targetEmail are
/// snapshots of the email at the moment the event happened, so a later
/// email change or account removal never rewrites history — the same
/// snapshot discipline Invoice already applies to client identity (see
/// CLAUDE.md "Invoicing — Phase A").
model ActivityEvent {
  id          String            @id @default(cuid())
  companyId   String
  type        ActivityEventType
  actorEmail  String
  targetEmail String?
  detail      String?
  createdAt   DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}
