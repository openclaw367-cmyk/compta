# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://compta:compta@localhost:5432/compta_fr_mc?schema=public"

PORT=3000

# Multi-user / roles & permissions (see CLAUDE.md) — REQUIRED, not
# optional: nothing works without a real JWT_ACCESS_SECRET, since auth is
# now core to every request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# The frontend's own origin — used for (1) CORS (the refresh-token cookie
# requires an exact origin + credentials:true, a wildcard is rejected by
# the CORS spec once credentials are involved) and (2) building the
# clickable links the console mailer prints (password reset, company
# invites). Defaults to the Vite dev server's own default port if unset.
FRONTEND_ORIGIN=http://localhost:5173

# Which MailerPort adapter sends password-reset/invite emails — see
# CLAUDE.md "Multi-user / roles & permissions" and "Mailer — SMTP
# adapter". "console" (the default) logs the email + a clickable link to
# the server console instead of sending anything — fully functional for
# local dev, zero external dependency, not a stopgap. "smtp" sends a real
# email via the SMTP_* settings below through nodemailer — ⚠️ NOT YET
# VERIFIED against a real SMTP account, see CLAUDE.md "Mailer — SMTP
# adapter" before relying on it in production.
MAILER_PROVIDER=console

# Only read when MAILER_PROVIDER=smtp — see CLAUDE.md "Mailer — SMTP
# adapter". Leave unset for the default console mode; the app starts fine
# without these and only fails, with a clear error, the first time an
# email actually tries to send under smtp mode.
# SMTP server host, e.g. smtp.gmail.com, smtp.sendgrid.net, your own relay.
SMTP_HOST=
# SMTP server port. 587 (STARTTLS) is the common default; 465 (implicit
# TLS/SMTPS) is the other common choice.
SMTP_PORT=587
# SMTP auth username.
SMTP_USER=
# SMTP auth password (or provider-specific API key used as a password,
# e.g. a Gmail app password or a SendGrid API key).
SMTP_PASS=
# The "From" address/display name on outgoing mail, e.g.
# "Citaledge <no-reply@votre-domaine.fr>".
SMTP_FROM=
# Optional. "true"/"1" forces implicit TLS (SMTPS, typically port 465);
# left unset, it's inferred from SMTP_PORT (465 = secure, else STARTTLS/
# plain) per nodemailer's own documented convention.
SMTP_SECURE=

# AI chatbot (see CLAUDE.md "AI chatbot") — local inference only, never an
# external API. Defaults below match a fresh Ollama install; only override
# if your setup differs. LOCAL_MODEL_NAME must be a model you've already
# pulled ("ollama pull <name>") with tool-calling support.
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b
LOCAL_MODEL_TIMEOUT_MS=120000

# AI chatbot cloud tier (see CLAUDE.md "AI chatbot cloud tier" and
# specs/ai-chatbot-cloud-tier-implementation-spec.md) — optional, only
# needed if a BYO cloud API key (Claude/DeepSeek) is ever saved for the
# propose_ecriture write path. Leave unset for a fully local install; the
# app starts fine without it and only fails, with a clear error, the first
# time someone actually tries to save a cloud credential. Generate a real
# value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Never commit a real value.
CLOUD_CREDENTIAL_ENCRYPTION_KEY=

# Bank reconciliation — Layer 1b, live aggregator connectivity (see
# CLAUDE.md "Bank reconciliation — Layer 1b") — optional, only needed to
# link a live Bridge bank connection. This is THIS DEPLOYMENT's own
# registered app identity with Bridge (one pair, shared by every company
# on this install), NOT a per-company secret — a company's own linked
# bank tokens are stored encrypted in the database instead, via the same
# CLOUD_CREDENTIAL_ENCRYPTION_KEY above. Leave unset for a fully
# manual-import install; the app starts fine without it and only fails,
# with a clear error, the first time someone tries to link a live bank
# account. ⚠️ Still a paper design against Bridge's public docs as of
# this writing — do not point this at a real Bridge production app
# before the pre-ship verification in CLAUDE.md is done.
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=

# Where attached écriture documents (justificatifs — invoice/receipt
# PDFs/images) live on local disk, per company subfolder — see CLAUDE.md
# "Supporting-document attachments". Local-first, same as chat history and
# local-model inference: never cloud storage. Relative paths resolve
# against the backend's own working directory. The default directory is
# gitignored.
DOCUMENT_STORAGE_DIR=./storage/documents
